{
    "id": null,
    "uid": "k6-performance",
    "title": "K6 Performance Test Results",
    "tags": ["k6", "performance", "testing"],
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 0,
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (Requests/sec)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(http_reqs[1m])",
            "refId": "A",
            "format": "time_series"
          }
        ]
      },
      {
        "id": 2,
        "title": "Active Virtual Users",
        "type": "graph",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "max(vu)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Response Time - P95",
        "type": "graph",
        "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, http_req_duration_ms)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Response Time - P99",
        "type": "graph",
        "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, http_req_duration_ms)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "rate(http_req_failed[1m])",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Booking Creation Time",
        "type": "graph",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "booking_creation_time",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Booking Operations Count",
        "type": "graph",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(booking_created_count[1m])",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Throughput (Requests/min)",
        "type": "stat",
        "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "rate(http_reqs[1m]) * 60",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "Failed Requests",
        "type": "stat",
        "gridPos": { "x": 6, "y": 24, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "increase(http_req_failed[1m])",
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "title": "Mean Response Time (ms)",
        "type": "stat",
        "gridPos": { "x": 12, "y": 24, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "avg(http_req_duration_ms)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 11,
        "title": "Success Rate %",
        "type": "stat",
        "gridPos": { "x": 18, "y": 24, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "(1 - rate(http_req_failed[1m])) * 100",
            "refId": "A"
          }
        ]
      }
    ]
  }
}
